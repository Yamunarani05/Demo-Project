# LUMINA Photography Management Backend Environment Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina_db

# JWT Authentication
JWT_SECRET=lumina_production_jwt_super_secret_key_2026
JWT_EXPIRES_IN=1d

# Email Notification Service (SMTP)
EMAIL_FROM="LUMINA Photography Management <noreply@lumina.io>"
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-account@gmail.com
# EMAIL_PASSWORD=your-app-password

# Razorpay Payment Gateway (Test Mode)
