# ================================================================
# DEMO PROJECT - UNIFIED FULL-STACK SAAS ENVIRONMENT
# ================================================================

# [PORT 5000] Primary Backend API Configuration (backend/)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Resilient Fallback: If not provided or unreachable, backend runs in memory-store mode
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/demoproject_db

# Email Notification Configuration (SMTP)
# Leave EMAIL_HOST empty to use Ethereal SMTP test preview URLs
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LUMINA Photography Management <noreply@lumina.io>"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_lumina12345
RAZORPAY_KEY_SECRET=lumina_razorpay_secret_67890

# ================================================================
# [PORT 5173] Frontend Web Application (frontend/)
# ================================================================
VITE_API_URL=http://localhost:5000/api

# ================================================================
# [PORT 5001] Standalone Pre-Production Backend (modules/pre-production/)
# ================================================================
PREPRODUCTION_PORT=5001
DB_PREPRODUCTION_HOST=localhost
DB_PREPRODUCTION_PORT=5432
DB_PREPRODUCTION_USER=postgres
DB_PREPRODUCTION_PASSWORD=postgres
DB_PREPRODUCTION_NAME=Redangle-Preproduction

# ================================================================
# [PORT 5011] Standalone MasterAdmin Backend (modules/master-admin/)
# ================================================================
MASTER_ADMIN_PORT=5011
DB_SALES_HOST=localhost
DB_SALES_PORT=5432
DB_SALES_USER=postgres
DB_SALES_PASSWORD=postgres
DB_SALES_NAME=postgres
